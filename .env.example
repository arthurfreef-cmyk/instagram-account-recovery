# Token privado da Apify. Nunca use prefixo VITE_ nesta variável.
# Gere em https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Ator padrão: apify~instagram-profile-scraper
# Pode ser substituído por outro ator compatível com entrada "usernames".
APIFY_INSTAGRAM_ACTOR=apify~instagram-profile-scraper
